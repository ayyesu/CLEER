{
  "name": "cleer",
  "version": "0.1.7",
  "description": "Computer Lifecycle, Efficiency & Environment Recovery — cross-platform disk space reclaimer",
  "author": "ayyesu",
  "license": "MIT",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:electron": "electron .",
    "build": "vite build && tsc -p tsconfig.main.json && tsc-alias -p tsconfig.main.json",
    "build:vite": "vite build",
    "build:main": "tsc -p tsconfig.main.json && tsc-alias -p tsconfig.main.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "version:check": "node scripts/check-version.cjs",
    "validate": "node scripts/validate-package.js",
    "smoke-test": "electron scripts/smoke-test.js",
    "capture:screens": "electron scripts/capture-screens.js",
    "package": "pnpm build && electron-builder",
    "package:win": "pnpm build && electron-builder --win",
    "package:mac": "pnpm build && electron-builder --mac",
    "package:linux": "pnpm build && electron-builder --linux"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electron/notarize": "^2.3.0",
    "@playwright/test": "^1.48.0",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.5",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "eslint": "^9.0.0",
    "js-yaml": "^5.2.3",
    "lucide-react": "^1.30.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.0",
    "tsc-alias": "^1.9.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "zustand": "^5.0.0"
  }
}
